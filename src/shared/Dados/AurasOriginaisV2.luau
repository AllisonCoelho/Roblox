V2.lista = {} :: { Aura }
V2.porId = {} :: { [string]: Aura }
local soma = 0
for _, d in DEFINICOES do
	if d[4] > 0 then
		soma += 1 / d[4]
	end
end
-- A reserva fica com o restante: "1 em N" mostrado = probabilidade real
V2.SOMA_EXPLICITAS = soma
V2.PROBABILIDADE_RESERVA = 1 - soma
for _, d in DEFINICOES do
	local aura: Aura = {
		numero = d[1],
		id = d[2],
		nome = d[3],
		chance = if d[4] > 0 then d[4] else 1 / (1 - soma),
		tier = d[5],
		familia = d[6],
		cores = { d[7], d[8] },
	}
	table.insert(V2.lista, aura)
	V2.porId[aura.id] = aura
end

-- Lote inicial de VFX (seção 8 do documento): sete famílias visuais diferentes
