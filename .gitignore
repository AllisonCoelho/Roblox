*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
# Modelos 3D do jogo (exportados do Studio) entram no Git
!assets/**/*.rbxm
!assets/**/*.rbxmx
/dist/
.env
.env.*
!.env.example

# Backups automáticos do Blender
*.blend1

# Cache do Python (geradores do Blender)
__pycache__/

# Pipeline de vídeos curtos: gravações, saídas e cache ficam só na máquina local
marketing/videos/entradas/*
!marketing/videos/entradas/.gitkeep
marketing/videos/saida/
marketing/videos/.cache/
